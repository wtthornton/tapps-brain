# syntax=docker/dockerfile:1
FROM python:3.13-slim

ARG TAPPS_BRAIN_VERSION=unknown
LABEL tapps_brain_version="${TAPPS_BRAIN_VERSION}"

# Install [http] + [mcp] + [reranker] + [otel] so the Docker reference stack
# ships FlashRank reranking and OTLP export (when OTEL_EXPORTER_OTLP_ENDPOINT
# is set).  Matches the other Dockerfiles (single pip invoke on the wheel).
COPY dist/tapps_brain-*.whl /tmp/
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
# TAP-6659: this stage installs from a pre-built wheel via plain `pip`, which
# does not read pyproject.toml's [tool.uv.sources]/[tool.uv.index] — those are
# uv-only config. Pin the CPU-only torch build here too, before installing the
# wheel, so the sentence-transformers dependency chain doesn't pull the
# CUDA-bundled PyPI build (15 nvidia-* packages) into a container with no GPU.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch==2.13.0+cpu"
RUN --mount=type=cache,target=/root/.cache/pip \
    whl=$(ls /tmp/tapps_brain-*.whl) \
    && pip install --no-cache-dir "${whl}[cli,mcp,http,reranker,otel]" "psycopg[binary]"

# TAP-4276 — bake the pinned embedding model for offline cold starts.
# Revision must match tapps_brain.embeddings._DEFAULT_MODEL_REVISION.
ENV HF_HOME=/opt/tapps-brain/hf-cache
ARG TAPPS_BRAIN_EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
RUN mkdir -p "${HF_HOME}" \
    && python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5', revision='${TAPPS_BRAIN_EMBEDDING_REVISION}')"

# Runtime: load from the baked cache only (no HuggingFace Hub contact).
ENV TAPPS_BRAIN_EMBEDDING_MODEL_OFFLINE=1
ENV HF_HUB_OFFLINE=1

# STORY-070.15: one binary, both transports.
# Port 8080 — HTTP data-plane + /mcp + /admin/* (FastAPI / Uvicorn).
# Port 8090 — operator Streamable-HTTP MCP transport (FastMCP).
# Both are started by `tapps-brain serve` when TAPPS_BRAIN_MCP_HTTP_PORT=8090.
EXPOSE 8080
EXPOSE 8090

# Aggregate healthcheck: container is healthy only when BOTH transports
# respond.  The MCP transport exposes /mcp/ (trailing slash per spec).
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=15s \
    CMD curl -fsS http://127.0.0.1:8080/health \
     && { [ -z "${TAPPS_BRAIN_MCP_HTTP_PORT}" ] \
          || curl -fsS "http://127.0.0.1:${TAPPS_BRAIN_MCP_HTTP_PORT}/health"; } \
     || exit 1

# STORY-070.15: unified entrypoint — starts both HTTP and MCP transports when
# TAPPS_BRAIN_MCP_HTTP_PORT is set.  Falls back to HTTP-only when the env var
# is absent (zero = disabled default in cmd_serve).
CMD ["tapps-brain", "serve"]
