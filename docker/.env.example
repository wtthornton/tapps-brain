# docker/.env — secrets + overrides for the unified tapps-brain stack.
#
# Copy this file to `docker/.env` and fill in strong random values BEFORE
# running `docker compose -p tapps-brain -f docker/docker-compose.hive.yaml up`.
# The compose file will refuse to start if any required variable is unset.
#
# DO NOT commit your docker/.env file — it is gitignored alongside the repo
# root .env (see .gitignore).

# ---------------------------------------------------------------------------
# REQUIRED — fill in before first `docker compose up`
# ---------------------------------------------------------------------------

# Postgres password for the `tapps` owner role on the brain DB container.
# This role runs DDL during the one-shot migrate sidecar only — the live
# brain container does NOT use this password.
# Generate with:  openssl rand -base64 32
TAPPS_BRAIN_DB_PASSWORD=REPLACE_ME_openssl_rand_base64_32

# Postgres password for the `tapps_runtime` DML-only role. The brain container
# connects as this role — no DDL, no BYPASSRLS, no table ownership. Created
# and grant-wired by the migrate sidecar (idempotent; re-running rolls it).
# Generate with:  openssl rand -base64 32
TAPPS_BRAIN_RUNTIME_PASSWORD=REPLACE_ME_openssl_rand_base64_32

# Bearer token that clients (IDE MCP clients, AgentBrain, AgentForge, etc.)
# present to the brain's data plane at :8080 — sent as `Authorization: Bearer <token>`
# along with `X-Project-Id`. Generate with:  openssl rand -hex 32
TAPPS_BRAIN_AUTH_TOKEN=REPLACE_ME_openssl_rand_hex_32

# Admin token for the operator MCP transport at :8090 (loopback-only by
# default). The operator transport refuses to start without this.
# Generate with:  openssl rand -hex 32
TAPPS_BRAIN_ADMIN_TOKEN=REPLACE_ME_openssl_rand_hex_32

# Comma-separated browser origins allowed to call the data plane. REQUIRED for
# local Docker: docker-compose.hive.yaml sets TAPPS_BRAIN_STRICT=1, and the
# brain refuses to start without this (crash-loop with Connection reset on :8080).
# Local dev default covers tapps-visual on :8088; add your IDE/dashboard origins
# in production.
TAPPS_BRAIN_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088

# ---------------------------------------------------------------------------
# REQUIRED (TAP-2686) — de-privileged migrate sidecar
# ---------------------------------------------------------------------------

# Postgres password for the `tapps_migrator` role. Schema-migration DDL runs as
# this NOSUPERUSER/NOBYPASSRLS role (it owns the FORCE-RLS tenanted tables), so
# the migrate sidecar no longer needs TAPPS_BRAIN_ALLOW_PRIVILEGED_ROLE and
# emits no "tenant isolation NOT enforced" audit line. Created/de-privileged and
# password-set by the one-time privileged bootstrap inside the sidecar
# (idempotent; re-running rolls it). Generate with:  openssl rand -base64 32
TAPPS_BRAIN_MIGRATOR_PASSWORD=REPLACE_ME_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# Deployment image version (TAP-2136)
# ---------------------------------------------------------------------------

BRAIN_VERSION=3.24.0

# ---------------------------------------------------------------------------
# Full feature promotion — Docker reference stack defaults (compose wires these)
# ---------------------------------------------------------------------------

# --- Connection pool sizing (TAP-2677) --------------------------------------
TAPPS_BRAIN_PG_POOL_MIN=1
TAPPS_BRAIN_PG_POOL_MAX=8
TAPPS_BRAIN_PG_POOL_CONNECT_TIMEOUT_SECONDS=10
TAPPS_BRAIN_HIVE_POOL_IDLE_TIMEOUT=300

# --- Embedding provider (TAP-2672) ------------------------------------------
# sentence-transformers is a core dependency; the brain auto-loads
# BAAI/bge-small-en-v1.5 (384-dim) at startup. REQUIRED=1 refuses lexical-only
# drift. Set MODEL_OFFLINE=1 after the HF cache volume is warm.
TAPPS_BRAIN_EMBEDDING_REQUIRED=1
TAPPS_BRAIN_EMBEDDING_MODEL_OFFLINE=0

# HuggingFace Hub token — strongly recommended for cold starts / cache eviction.
# Generate at https://huggingface.co/settings/tokens (read access is enough).
# HF_TOKEN=REPLACE_ME_hf_read_token

# --- Library doc RAG (ADR-0014) --------------------------------------------
# Context7 key lives on the brain service only after fleet cutover.
CONTEXT7_API_KEY=
DOCS_CACHE_TTL=86400
TAPPS_BRAIN_DOCS_PROJECT_ID=library-docs

# --- FlashRank reranker ------------------------------------------------------
# Installed in the http image via [reranker] extra. No env toggle — active when
# flashrank import succeeds (InjectionConfig.reranker_enabled=True by default).

# --- Write idempotency (STORY-070.5) ----------------------------------------
# ON by default in compose. Set 0 to disable X-Idempotency-Key replay cache.
TAPPS_BRAIN_IDEMPOTENCY=1

# --- Per-tenant auth (STORY-070.8) -------------------------------------------
# ON by default. Requires X-Project-Id on every request. Projects without a
# rotated per-tenant token still accept TAPPS_BRAIN_AUTH_TOKEN (fallback).
# Set 0 for legacy single-token-only mode.
TAPPS_BRAIN_PER_TENANT_AUTH=1

# --- OTel export ([otel] extra in http image) --------------------------------
TAPPS_BRAIN_OTEL_ENABLED=1
OTEL_SERVICE_NAME=tapps-brain
OTEL_EXPORTER_OTLP_TIMEOUT=5.0
# Uncomment when an OTLP collector is reachable from the container network:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317

# --- Prometheus /metrics gate (TAP-547) ------------------------------------
# Strongly recommended in any network-exposed deployment. When unset, /metrics
# is callable without auth (tenant labels redacted).
# TAPPS_BRAIN_METRICS_TOKEN=REPLACE_ME_openssl_rand_hex_32

# Project id injected into tapps-visual's /snapshot proxy (X-Project-Id).
# Must match a registered project when TAPPS_BRAIN_STRICT_PROJECTS=1.
TAPPS_BRAIN_PROJECT=default

# --- MCP tools/list surface --------------------------------------------------
# Docker reference stack exposes all profile tools eagerly (no defer_loading).
# Server default profile when clients omit X-Brain-Profile:
# TAPPS_BRAIN_DEFAULT_PROFILE=full

# ---------------------------------------------------------------------------
# OPTIONAL — host ports / bind overrides
# ---------------------------------------------------------------------------

# TAPPS_HTTP_PORT=8080
# TAPPS_VISUAL_PORT=8088
# TAPPS_OPERATOR_MCP_PORT=8090
# TAPPS_OPERATOR_MCP_BIND=127.0.0.1
