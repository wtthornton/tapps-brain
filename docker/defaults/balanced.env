# Tier: BALANCED — recommended CODING stack (IDE agents, this repo)
# Merge after secrets: see docker/defaults/README.md
#
# Client: tapps-mcp + optional direct brain MCP; X-Brain-Profile: coder

TAPPS_BRAIN_TIER=balanced

TAPPS_BRAIN_PG_POOL_MIN=1
TAPPS_BRAIN_PG_POOL_MAX=8
TAPPS_BRAIN_PG_POOL_CONNECT_TIMEOUT_SECONDS=10
TAPPS_BRAIN_HIVE_POOL_IDLE_TIMEOUT=300

TAPPS_BRAIN_EMBEDDING_REQUIRED=1
TAPPS_BRAIN_EMBEDDING_MODEL_OFFLINE=0

TAPPS_BRAIN_IDEMPOTENCY=0
TAPPS_BRAIN_PER_TENANT_AUTH=0
TAPPS_BRAIN_OTEL_ENABLED=0

TAPPS_BRAIN_DEFAULT_PROFILE=coder
