# Tier: IT13 — unified dev/POC workstation (hostname it13)
# Machine profile: coding + AgentForge POC + pytest; NOT production runtime.
# Full topology, log notes, and redeploy: docker/defaults/it13.md
#
# Base posture: balanced (idempotency/auth/OTel off, pool max 8, MCP coder).
# IT13 delta: HF cache volume is warm — load embeddings offline after first deploy.

TAPPS_BRAIN_TIER=it13

TAPPS_BRAIN_PG_POOL_MIN=1
TAPPS_BRAIN_PG_POOL_MAX=8
TAPPS_BRAIN_PG_POOL_CONNECT_TIMEOUT_SECONDS=10
TAPPS_BRAIN_HIVE_POOL_IDLE_TIMEOUT=300

TAPPS_BRAIN_EMBEDDING_REQUIRED=1
TAPPS_BRAIN_EMBEDDING_MODEL_OFFLINE=1

TAPPS_BRAIN_IDEMPOTENCY=0
TAPPS_BRAIN_PER_TENANT_AUTH=0
TAPPS_BRAIN_OTEL_ENABLED=0

TAPPS_BRAIN_DEFAULT_PROFILE=coder

# Optional — enable when rehearsing runtime observability (Jaeger on host :4317):
# TAPPS_BRAIN_OTEL_ENABLED=1
# OTEL_SERVICE_NAME=tapps-brain-it13
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
