# Tier: QUALITY — recommended RUNTIME stack (many agents / production projects)
# Merge after secrets: see docker/defaults/README.md
#
# Client: direct brain MCP or AgentForge; per-project tokens after rotate-token
# Set TAPPS_BRAIN_METRICS_TOKEN and OTEL_EXPORTER_OTLP_ENDPOINT in docker/.env

TAPPS_BRAIN_TIER=quality

TAPPS_BRAIN_PG_POOL_MIN=2
TAPPS_BRAIN_PG_POOL_MAX=20
TAPPS_BRAIN_PG_POOL_CONNECT_TIMEOUT_SECONDS=10
TAPPS_BRAIN_HIVE_POOL_IDLE_TIMEOUT=600

TAPPS_BRAIN_EMBEDDING_REQUIRED=1
TAPPS_BRAIN_EMBEDDING_MODEL_OFFLINE=0

TAPPS_BRAIN_IDEMPOTENCY=1
TAPPS_BRAIN_PER_TENANT_AUTH=1
TAPPS_BRAIN_OTEL_ENABLED=1
OTEL_SERVICE_NAME=tapps-brain-runtime
OTEL_EXPORTER_OTLP_TIMEOUT=5.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://your-collector:4317

TAPPS_BRAIN_DEFAULT_PROFILE=coder
